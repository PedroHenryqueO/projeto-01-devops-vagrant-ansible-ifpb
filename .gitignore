/PROGRESSO.md
/ansible/clients.yml
/scripts/verificador-isolado.sh
/referencias/*
!/referencias/README.md
# Historico local; somente a matriz e documentacao final sao distribuidos
/docs/*
!/docs/MATRIZ-REQUISITOS.md

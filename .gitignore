*.vhd
*.vhdx
*.sav
*.ova
*.box
# Segredos: apenas chaves publicas podem ser versionadas explicitamente
keys/
.ssh/
.aws/
.env
.env.*
secrets/
credentials/
private_key*
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx
*.retry

options {
    directory "/var/cache/bind";
    listen-on { 127.0.0.1; {{ dns_ip }}; };
    listen-on-v6 { none; };
    allow-query { localhost; {{ private_cidr }}; };
    allow-recursion { localhost; {{ private_cidr }}; };
    allow-transfer { none; };
    recursion yes;
    forwarders { 1.1.1.1; 8.8.8.8; };
    dnssec-validation auto;
};
